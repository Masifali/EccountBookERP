    <queryString language="SQL">
        <![CDATA[SELECT cp.name as accountName, br.name as branchName, fy.name as financialName, it.formatted_code as formattedCode, it.name as itemName, ac.account_name as accountTitle, ac.formatted_code as accountFormatCode
, dt.pre_purchase_code as prePurchaseCode, dt.entry_date as entryDate, dt.vahical_no as vehicleNumber, dt.bag as bag, dt.kg as weight, dt.freight, dt.rate, dt.remarks
FROM pre_purchase m LEFT JOIN branch br ON br.id = m.branch_id LEFT JOIN company cp ON cp.id = m.company_id LEFT JOIN financial_year fy ON fy.id = m.financial_year_id LEFT JOIN pre_purchase_entry dt ON dt.pre_purchase_id = m.id LEFT JOIN item_def it ON it.id = dt.item_def_id LEFT JOIN account ac ON ac.code = dt.account_code]]>
    </queryString>
