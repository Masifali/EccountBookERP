<style fontName="Jameel Noori Nastaleeq" size="11" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" forecolor="#000000">نو ٹ :۔   میں ۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔ آپ کو یقین دہانی کرواتا ہوں کہ جو کنٹینر میں  لیکر جا رہاہوں اس  میں میری نگرانی میں چاول لوڈ کیا گیا ہےکنٹینر کو ۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔۔ مقام تک پہچانے کا میں ذمہ دار ہوں۔اگر راستے میں کوئی مسئلہ پیش آتا ہے تو میں اس کا ذمہ دار ہوں۔ </style>]]></text></staticText><textField textAdjust="CutText" isBlankWhenNull="true"><reportElement key="DriverName2" x="373" y="177" width="142" height="13" mode="Transparent" forecolor="#000000"/><textElement textAlignment="Left" verticalAlignment="Top"><font fontName="Calibri" size="10"/><paragraph lineSpacing="Fixed" lineSpacingSize="10"/></textElement><textFieldExpression><![CDATA[CR.v($F{DriverName})]]></textFieldExpression></textField><staticText><reportElement key="Text17" x="14" y="266" width="128" height="13" mode="Transparent" forecolor="#000000"/><textElement textAlignment="Center" verticalAlignment="Top" markup="styled"><font fontName="Arial" size="10" isBold="true"/><paragraph lineSpacing="Fixed" lineSpacingSize="10"/></textElement><text><![CDATA[<style fontName="Arial" size="10" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" forecolor="#000000">Prepaid By</style>]]></text></staticText><line><reportElement x="14" y="263" width="129" height="1" mode="Transparent"/><graphicElement><pen lineWidth="1" lineStyle="Solid" lineColor="#000000"/></graphicElement></line><line><reportElement x="429" y="261" width="125" height="1" mode="Transparent"/><graphicElement><pen lineWidth="1" lineStyle="Solid" lineColor="#000000"/></graphicElement></line><staticText><reportElement key="Text9" x="428" y="265" width="125" height="13" mode="Transparent" forecolor="#000000"/><textElement textAlignment="Center" verticalAlignment="Top" markup="styled"><font fon