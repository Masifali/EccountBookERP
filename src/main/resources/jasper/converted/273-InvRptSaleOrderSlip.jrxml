<?xml version="1.0" encoding="UTF-8"?>
<!--
  273-InvRptSaleOrderSlip.rpt  ->  JasperReports
  Layout taken from the .rpt's own saved preview picture (SummaryInformation thumbnail, 163x211 px,
  scaled 3.65 pt/px across, 3.99 pt/px down); data from Sp_SaleOrder_RiceSlip_Rpt, exactly the
  columns the desktop hands the report (SaleOrderReports.SaleOrderReports273, @OrderId = the order).
  Sections (thumbnail px -> pt):
    company header  y  7-24  : logo | company name / address / contacts   (page header, boxed)
    title bar       y 24-33  : "Sale Order Slip"
    order header    y 33-62  : 6 label/value rows left, 5 right           (group header, per order)
    column header   y 62-66  : 9 columns  x = 7,49,60,71,83,93,108,119,131,156
    detail          5 px/row : item + second line, numbers
    totals          y 82-85  : Total / qty / weight / amount             (group footer)
    then the customer-expense sub-report (SaleOrderCustomerExpense_SubReport.rpt), amount in
    words, header amounts and signatures, all in the group footer.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="273_InvRptSaleOrderSlip" language="java" pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="544" leftMargin="26" rightMargin="25" topMargin="28" bottomMargin="28"
              whenNoDataType="NoPages" uuid="6f1a0f2e-2730-4a45-9d11-273000000001">

    <import value="com.mst.reports.jasper.CR"/>

    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="8" isBlankWhenNull="true"/>
    <style name="Label" style="Base" forecolor="#1F3A5F"/>
    <style name="Value" style="Base" forecolor="#000000"/>
    <style name="ValueBold" style="Value" isBold="true"/>
    <style name="ValueItalic" style="Value" isItalic="true"/>
    <style name="ValueRed" style="Value" forecolor="#C0392B"/>
    <style name="Value9" style="Value" fontSize="9"/>
    <style name="Small" style="Base" fontSize="7" forecolor="#555555"/>
    <style name="Company" style="Base" fontSize="16" isBold="true" forecolor="#1F3A5F"/>
    <style name="Title" style="Base" fontSize="13" isBold="true" forecolor="#1F6F8B"/>
    <style name="ColHead" style="Base" isBold="true" forecolor="#FFFFFF" mode="Opaque" backcolor="#2E6E6E" hTextAlign="Center" vTextAlign="Middle"/>
    <style name="ColHeadLeft" style="ColHead" hTextAlign="Left"/>
    <style name="Cell" style="Base" vTextAlign="Middle"/>
    <style name="CellNum" style="Cell" hTextAlign="Right"/>
    <style name="CellSmall" style="Base" fontSize="6.5" forecolor="#555555"/>
    <style name="Total" style="Base" isBold="true" vTextAlign="Middle"/>
    <style name="TotalNum" style="Total" hTextAlign="Right"/>
    <style name="TotalShade" style="Total" mode="Opaque" backcolor="#E8E8E8"/>

    <!-- desktop: val.RptPerameter("@CompanyName" / "@CompanyAddress", UserAccount.Comp...) -->
    <parameter name="CompanyName" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
    <parameter name="CompanyAddress" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
    <parameter name="CR_VARS" class="java.lang.Object" isForPrompting="false"/>
    <parameter name="SUBREPORT_SaleOrderCustomerExpense_SubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="SUBDATA_SaleOrderCustomerExpense_SubReport" class="java.util.Collection" isForPrompting="false"/>

    <!-- Sp_SaleOrder_RiceSlip_Rpt: one row per order line (sod), header columns repeated -->
    <field name="Id" class="java.lang.Integer"/>
    <field name="DocumentTypeDescription" class="java.lang.String"/>
    <field name="DocNo" class="java.lang.Integer"/>
    <field name="DocDate" class="java.util.Date"/>
    <field name="OrderCategoryName" class="java.lang.String"/>
