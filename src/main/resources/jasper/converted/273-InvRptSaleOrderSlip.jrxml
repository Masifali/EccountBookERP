    <field name="SupplierName" class="java.lang.String"/>
    <field name="CustomerMobileNumber" class="java.lang.String"/>
    <field name="CustomerCity" class="java.lang.String"/>
    <field name="CustomerAddress" class="java.lang.String"/>
    <field name="SupplierRefNo" class="java.lang.String"/>
    <field name="DecimalsForRate" class="java.lang.Integer"/>
    <field name="DecimalsForAmount" class="java.lang.Integer"/>
    <field name="CompanyNameSpCAgent" class="java.lang.String"/>
    <field name="CommissionType" class="java.lang.String"/>
    <field name="CommRate" class="java.math.BigDecimal"/>
    <field name="CommAmount" class="java.math.BigDecimal"/>
    <field name="CommissionRemarks" class="java.lang.String"/>
    <field name="TermsDescription" class="java.lang.String"/>
    <field name="OrderDueDays" class="java.lang.Integer"/>
    <field name="OrderDueDate" class="java.util.Date"/>
    <field name="OrderExpiryDate" class="java.util.Date"/>
    <field name="DeliveryTerm" class="java.lang.String"/>
    <field name="DeliveryStartDate" class="java.util.Date"/>
    <field name="DeliveryDays" class="java.lang.Integer"/>
    <field name="DeliveryRemarks" class="java.lang.String"/>
    <field name="RemarksHeader" class="java.lang.String"/>
    <field name="OrderStatus" class="java.lang.String"/>
    <field name="IsAproved" class="java.lang.Boolean"/>
    <field name="UserNameEusr" class="java.lang.String"/>
    <field name="EntryDate" class="java.util.Date"/>
    <field name="UserNameAusr" class="java.lang.String"/>
    <field name="ItemAmountHeader" class="java.math.BigDecimal"/>
    <field name="DiscountAmountHeader" class="java.math.BigDecimal"/>
    <field name="TaxAmountHeader" class="java.math.BigDecimal"/>
    <field name="OrderAmount" class="java.math.BigDecimal"/>
    <field name="OrderQty" class="java.math.BigDecimal"/>
    <field name="OrderWeight" class="java.math.BigDecimal"/>
    <field name="DiscountType" class="java.lang.String"/>
    <field name="ItemCode" class="java.lang.String"/>
    <field name="ItemName" class="java.lang.String"/>
    <field name="OrderItemQty" class="java.math.BigDecimal"/>
    <field name="UOMCodeItm" class="java.lang.String"/>
    <field name="Crop" class="java.lang.String"/>
    <field name="NetWeight" class="java.math.BigDecimal"/>
    <field name="OrderItemRate" class="java.math.BigDecimal"/>
    <field name="ItemPrice" class="java.math.BigDecimal"/>
    <field name="RateDiscount" class="java.math.BigDecimal"/>
    <field name="UOMCodeRate" class="java.lang.String"/>
    <field name="Amount" class="java.math.BigDecimal"/>
    <field name="CityArea" class="java.lang.String"/>
    <field name="LabSampleNo" class="java.lang.String"/>
    <field name="OrderRemarks" class="java.lang.String"/>
    <field name="JobLotCode" class="java.lang.String"/>
    <field name="BagWeight" class="java.math.BigDecimal"/>
    <field name="DispatchQty" class="java.math.BigDecimal"/>
    <field name="DispatchWeight" class="java.math.BigDecimal"/>
    <field name="CompMobileA" class="java.lang.String"/>
    <field name="CompEmailA" class="java.lang.String"/>
    <field name="CompanyWebsite" class="java.lang.String"/>
    <field name="CompLogoImage" class="java.lang.Object"/>
    <field name="OrgReportingRemarks" class="java.lang.String"/>
    <field name="BookingPerson" class="java.lang.String"/>
    <field name="ItemCondition" class="java.lang.String"/>

    <sortField name="Id"/>
    <sortField name="ItemName"/>

    <variable name="QtyTotal" class="java.math.BigDecimal" resetType="Group" resetGroup="Order" calculation="Sum">
        <variableExpression><![CDATA[$F{OrderItemQty}]]></variableExpression>
    </variable>
    <variable name="WeightTotal" class="java.math.BigDecimal" resetType="Group" resetGroup="Order" calculation="Sum">
        <variableExpression><![CDATA[$F{NetWeight}]]></variableExpression>
    </variable>
    <variable name="AmountTotal" class="java.math.BigDecimal" resetType="Group" resetGroup="Order" calculation="Sum">
        <variableExpression><![CDATA[$F{Amount}]]></variableExpression>
    </variable>
    <!-- Sp_SaleOrder_RiceSlip_Rpt: DecimalsForAmount = config 78, DecimalsForRate = config 77 -->
    <variable name="AmtPattern" class="java.lang.String">
        <variableExpression><![CDATA[$F{DecimalsForAmount} == null || $F{DecimalsForAmount} <= 0 ? "#,##0" : "#,##0." + "0000000000".substring(0, Math.min(10, $F{DecimalsForAmount}))]]></variableExpression>
    </variable>
    <variable name="RatePattern" class="java.lang.String">
        <variableExpression><![CDATA[$F{DecimalsForRate} == null || $F{DecimalsForRate} <= 0 ? "#,##0" : "#,##0." + "0000000000".substring(0, Math.min(10, $F{DecimalsForRate}))]]></variableExpression>
    </variable>

    <group name="Order" isStartNewPage="false" isReprintHeaderOnEachPage="true">
        <groupExpression><![CDATA[$F{Id}]]></groupExpression>
        <groupHeader>
            <band height="132" splitType="Prevent">
                <!-- order header block: y 33-62 px -> 116 pt -->
                <frame>
                    <reportElement x="0" y="0" width="544" height="116"/>
                    <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>

                    <staticText><reportElement style="Label" x="8" y="6" width="70" height="12"/><text><![CDATA[Doc No]]></text></staticText>
                    <textField><reportElement style="Value" x="80" y="6" width="170" height="12"/>
                        <textFieldExpression><![CDATA[String.valueOf($F{DocNo}) + ($F{CatagorySrNo} != null && $F{CatagorySrNo} > 0 ? "   (" + CR.nzs($F{OrderCategoryName}) + " " + $F{CatagorySrNo} + ")" : "")]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="20" width="70" height="12"/><text><![CDATA[Doc Date]]></text></staticText>
                    <textField pattern="dd-MMM-yyyy"><reportElement style="Value" x="80" y="20" width="170" height="12"/>
                        <textFieldExpression><![CDATA[$F{DocDate}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="34" width="70" height="12"/><text><![CDATA[Customer Name]]></text></staticText>
                    <textField><reportElement style="ValueBold" x="80" y="34" width="245" height="12"/>
                        <textFieldExpression><![CDATA[$F{SupplierName}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="48" width="70" height="12"/><text><![CDATA[Address]]></text></staticText>
                    <textField textAdjust="StretchHeight"><reportElement style="Value" x="80" y="48" width="245" height="12"/>
                        <textFieldExpression><![CDATA[CR.nzs($F{CustomerAddress}) + ($F{CustomerCity} != null && !$F{CustomerCity}.isEmpty() ? ", " + $F{CustomerCity} : "") + ($F{CustomerMobileNumber} != null && !$F{CustomerMobileNumber}.isEmpty() ? "   Ph: " + $F{CustomerMobileNumber} : "")]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="62" width="70" height="12"/><text><![CDATA[Booking Person]]></text></staticText>
                    <textField><reportElement style="Value" x="80" y="62" width="245" height="12"/>
                        <textFieldExpression><![CDATA[CR.nzs($F{BookingPerson}) + ($F{SupplierRefNo} != null && !$F{SupplierRefNo}.isEmpty() ? "   Ref: " + $F{SupplierRefNo} : "")]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="76" width="70" height="12"/><text><![CDATA[Remarks]]></text></staticText>
                    <textField textAdjust="StretchHeight"><reportElement style="ValueRed" x="80" y="76" width="245" height="12"/>
                        <textFieldExpression><![CDATA[$F{RemarksHeader}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="8" y="96" width="70" height="12"/><text><![CDATA[Delivery Remarks]]></text></staticText>
                    <textField><reportElement style="Value" x="80" y="96" width="245" height="12"/>
                        <textFieldExpression><![CDATA[$F{DeliveryRemarks}]]></textFieldExpression></textField>

                    <!-- right column: x 98 px -> 332 pt labels, 125 px -> 430 pt values -->
                    <staticText><reportElement style="Label" x="332" y="6" width="96" height="12"/><text><![CDATA[Commission Agent]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="6" width="108" height="12"/>
                        <textFieldExpression><![CDATA[$F{CompanyNameSpCAgent}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="20" width="96" height="12"/><text><![CDATA[Comm Rate]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="20" width="108" height="12"/>
                        <textFieldExpression><![CDATA[$F{CommRate} == null || $F{CommRate}.signum() == 0 ? "" : CR.toText($F{CommRate}, $F{DecimalsForRate}) + " " + CR.nzs($F{CommissionType})]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="34" width="96" height="12"/><text><![CDATA[Payment Terms]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="34" width="108" height="12"/>
                        <textFieldExpression><![CDATA[$F{TermsDescription}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="48" width="96" height="12"/><text><![CDATA[Due Days / Date]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="48" width="108" height="12"/>
                        <textFieldExpression><![CDATA[($F{OrderDueDays} != null && $F{OrderDueDays} > 0 ? $F{OrderDueDays} + "  " : "") + ($F{OrderDueDate} != null ? new java.text.SimpleDateFormat("dd-MMM-yyyy").format($F{OrderDueDate}) : "")]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="62" width="96" height="12"/><text><![CDATA[Delivery Term]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="62" width="108" height="12"/>
                        <textFieldExpression><![CDATA[CR.nzs($F{DeliveryTerm}) + ($F{DeliveryDays} != null && $F{DeliveryDays} > 0 ? "  " + $F{DeliveryDays} + " days" : "")]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="76" width="96" height="12"/><text><![CDATA[Delivery Start]]></text></staticText>
                    <textField pattern="dd-MMM-yyyy"><reportElement style="Value" x="430" y="76" width="108" height="12"/>
                        <textFieldExpression><![CDATA[$F{DeliveryStartDate}]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="332" y="96" width="96" height="12"/><text><![CDATA[Status]]></text></staticText>
                    <textField><reportElement style="Value" x="430" y="96" width="108" height="12"/>
                        <textFieldExpression><![CDATA[CR.nzs($F{OrderStatus}) + (Boolean.TRUE.equals($F{IsAproved}) ? "  (Approved)" : "")]]></textFieldExpression></textField>
                </frame>

                <!-- column header: 9 columns from the thumbnail, widths 153,40,40,44,44,48,40,44,91 -->
                <frame>
                    <reportElement style="ColHead" x="0" y="116" width="544" height="16"/>
                    <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <staticText><reportElement style="ColHeadLeft" x="0" y="0" width="153" height="16"/><box leftPadding="3"><rightPen lineWidth="1.0"/></box><text><![CDATA[Item]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="153" y="0" width="40" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Qty]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="193" y="0" width="40" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[UOM]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="233" y="0" width="44" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Net Wt]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="277" y="0" width="44" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Rate]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="321" y="0" width="48" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Rate UOM]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="369" y="0" width="40" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Price]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="409" y="0" width="44" height="16"/><box><rightPen lineWidth="1.0"/></box><text><![CDATA[Discount]]></text></staticText>
                    <staticText><reportElement style="ColHead" x="453" y="0" width="91" height="16"/><text><![CDATA[Amount]]></text></staticText>
                </frame>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="150" splitType="Prevent">
                <!-- totals row, y 82-85 px -->
                <frame>
                    <reportElement x="0" y="0" width="544" height="14"/>
                    <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <staticText><reportElement style="TotalShade" x="3" y="0" width="150" height="14"/><box leftPadding="3"/><text><![CDATA[Total]]></text></staticText>
                    <textField pattern="#,##0.00"><reportElement style="TotalNum" x="153" y="0" width="40" height="14"/><box rightPadding="2"/><textFieldExpression><![CDATA[$V{QtyTotal}]]></textFieldExpression></textField>
                    <textField pattern="#,##0.00"><reportElement style="TotalNum" x="233" y="0" width="44" height="14"/><box rightPadding="2"/><textFieldExpression><![CDATA[$V{WeightTotal}]]></textFieldExpression></textField>
                    <textField><reportElement style="TotalNum" x="453" y="0" width="91" height="14"/><box rightPadding="3"/><textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($V{AmountTotal} == null ? java.math.BigDecimal.ZERO : $V{AmountTotal})]]></textFieldExpression></textField>
                </frame>

                <!-- desktop: new SubReportObject(SaleOrderCustomerExpense_SubReport(id), "SaleOrderCustomerExpense_SubReport.rpt") -->
                <subreport isUsingCache="false">
                    <reportElement x="0" y="18" width="544" height="20" isRemoveLineWhenBlank="true" positionType="Float"/>
                    <parametersMapExpression><![CDATA[CR.subParams($P{REPORT_PARAMETERS_MAP})]]></parametersMapExpression>
                    <subreportParameter name="REPORT_LOCALE"><subreportParameterExpression><![CDATA[$P{REPORT_LOCALE}]]></subreportParameterExpression></subreportParameter>
                    <dataSourceExpression><![CDATA[CR.ds($P{REPORT_PARAMETERS_MAP}, "SUBDATA_SaleOrderCustomerExpense_SubReport")]]></dataSourceExpression>
                    <subreportExpression><![CDATA[CR.sub($P{REPORT_PARAMETERS_MAP}, "SUBREPORT_SaleOrderCustomerExpense_SubReport")]]></subreportExpression>
                </subreport>

                <!-- header amounts and amount in words -->
                <frame>
                    <reportElement x="0" y="42" width="544" height="58" positionType="Float"/>
                    <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <staticText><reportElement style="Label" x="8" y="4" width="90" height="12"/><text><![CDATA[Amount in Words]]></text></staticText>
                    <textField textAdjust="StretchHeight"><reportElement style="ValueItalic" x="100" y="4" width="240" height="12"/>
                        <textFieldExpression><![CDATA[$F{OrderAmount} == null ? "" : "Rupees " + CR.toWords($F{OrderAmount}, $F{DecimalsForAmount}) + " only"]]></textFieldExpression></textField>
                    <staticText><reportElement style="Label" x="8" y="20" width="90" height="12"/><text><![CDATA[Commission]]></text></staticText>
                    <textField><reportElement style="Value" x="100" y="20" width="240" height="12"/>
                        <textFieldExpression><![CDATA[$F{CommAmount} == null || $F{CommAmount}.signum() == 0 ? "" : new java.text.DecimalFormat($V{AmtPattern}).format($F{CommAmount}) + "   " + CR.nzs($F{CommissionRemarks})]]></textFieldExpression></textField>
                    <staticText><reportElement style="Label" x="8" y="34" width="90" height="12"/><text><![CDATA[Dispatched]]></text></staticText>
                    <textField><reportElement style="Value" x="100" y="34" width="240" height="12"/>
                        <textFieldExpression><![CDATA["Qty " + new java.text.DecimalFormat("#,##0.00").format($F{DispatchQty} == null ? java.math.BigDecimal.ZERO : $F{DispatchQty}) + "   Weight " + new java.text.DecimalFormat("#,##0.00").format($F{DispatchWeight} == null ? java.math.BigDecimal.ZERO : $F{DispatchWeight})]]></textFieldExpression></textField>

                    <staticText><reportElement style="Label" x="360" y="4" width="90" height="12"/><text><![CDATA[Item Amount]]></text></staticText>
                    <textField><reportElement style="CellNum" x="450" y="4" width="88" height="12"/>
                        <textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{ItemAmountHeader} == null ? java.math.BigDecimal.ZERO : $F{ItemAmountHeader})]]></textFieldExpression></textField>
                    <staticText><reportElement style="Label" x="360" y="18" width="90" height="12"/><text><![CDATA[Discount]]></text></staticText>
                    <textField><reportElement style="CellNum" x="450" y="18" width="88" height="12"/>
                        <textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{DiscountAmountHeader} == null ? java.math.BigDecimal.ZERO : $F{DiscountAmountHeader})]]></textFieldExpression></textField>
                    <staticText><reportElement style="Label" x="360" y="32" width="90" height="12"/><text><![CDATA[Tax]]></text></staticText>
                    <textField><reportElement style="CellNum" x="450" y="32" width="88" height="12"/>
                        <textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{TaxAmountHeader} == null ? java.math.BigDecimal.ZERO : $F{TaxAmountHeader})]]></textFieldExpression></textField>
                    <line><reportElement x="360" y="45" width="178" height="1"/></line>
                    <staticText><reportElement style="Total" x="360" y="46" width="90" height="12"/><text><![CDATA[Order Amount]]></text></staticText>
                    <textField><reportElement style="TotalNum" x="450" y="46" width="88" height="12"/>
                        <textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{OrderAmount} == null ? java.math.BigDecimal.ZERO : $F{OrderAmount})]]></textFieldExpression></textField>
                </frame>

                <!-- signatures -->
                <frame>
                    <reportElement x="0" y="104" width="544" height="46" positionType="Float"/>
                    <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <textField><reportElement style="Small" x="8" y="4" width="400" height="11"/>
                        <textFieldExpression><![CDATA["Entered by " + CR.nzs($F{UserNameEusr}) + ($F{EntryDate} != null ? " on " + new java.text.SimpleDateFormat("dd-MMM-yyyy hh:mm a").format($F{EntryDate}) : "") + (Boolean.TRUE.equals($F{IsAproved}) && $F{UserNameAusr} != null ? "   Approved by " + $F{UserNameAusr} : "")]]></textFieldExpression></textField>
                    <line><reportElement x="20" y="32" width="130" height="1"/></line>
                    <line><reportElement x="207" y="32" width="130" height="1"/></line>
                    <line><reportElement x="394" y="32" width="130" height="1"/></line>
                    <staticText><reportElement style="Label" x="20" y="34" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Prepared By]]></text></staticText>
                    <staticText><reportElement style="Label" x="207" y="34" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Approved By]]></text></staticText>
                    <staticText><reportElement style="Label" x="394" y="34" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Customer]]></text></staticText>
                </frame>
            </band>
        </groupFooter>
    </group>

    <pageHeader>
        <band height="104">
            <!-- company header, y 7-24 px -> 68 pt -->
            <frame>
                <reportElement x="0" y="0" width="544" height="68"/>
                <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                    <reportElement x="4" y="4" width="40" height="60"><printWhenExpression><![CDATA[CR.img($F{CompLogoImage}) != null]]></printWhenExpression></reportElement>
                    <imageExpression><![CDATA[CR.img($F{CompLogoImage})]]></imageExpression>
                </image>
                <textField><reportElement style="Company" x="50" y="4" width="488" height="22"/>
                    <textElement verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[$P{CompanyName}]]></textFieldExpression></textField>
                <textField><reportElement style="Value9" x="50" y="28" width="488" height="14"/>
                    <textFieldExpression><![CDATA[$P{CompanyAddress}]]></textFieldExpression></textField>
                <textField><reportElement style="Value" x="50" y="46" width="488" height="12"/>
                    <textFieldExpression><![CDATA[($F{CompMobileA} != null && !$F{CompMobileA}.isEmpty() ? "Ph: " + $F{CompMobileA} : "") + ($F{CompEmailA} != null && !$F{CompEmailA}.isEmpty() ? "     Email: " + $F{CompEmailA} : "") + ($F{CompanyWebsite} != null && !$F{CompanyWebsite}.isEmpty() ? "     " + $F{CompanyWebsite} : "")]]></textFieldExpression></textField>
            </frame>
            <!-- title bar, y 24-33 px -> 36 pt -->
            <frame>
                <reportElement x="0" y="68" width="544" height="36"/>
                <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement style="Title" x="0" y="0" width="544" height="36"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA["Sale Order Slip"]]></textFieldExpression></textField>
            </frame>
        </band>
    </pageHeader>

    <detail>
        <band height="20" splitType="Prevent">
            <frame>
                <reportElement x="0" y="0" width="544" height="20"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement style="Cell" x="0" y="1" width="153" height="10"/><box leftPadding="3"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[CR.nzs($F{ItemName}) + ($F{ItemCode} != null && !$F{ItemCode}.isEmpty() ? "  [" + $F{ItemCode} + "]" : "")]]></textFieldExpression></textField>
                <textField><reportElement style="CellSmall" x="0" y="11" width="153" height="9"/><box leftPadding="3"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[($F{Crop} != null && !$F{Crop}.isEmpty() ? "Crop " + $F{Crop} + "  " : "") + ($F{JobLotCode} != null && !$F{JobLotCode}.isEmpty() ? "Lot " + $F{JobLotCode} + "  " : "") + ($F{CityArea} != null && !$F{CityArea}.isEmpty() ? $F{CityArea} + "  " : "") + ($F{ItemCondition} != null && !$F{ItemCondition}.isEmpty() ? $F{ItemCondition} + "  " : "") + ($F{LabSampleNo} != null && !$F{LabSampleNo}.isEmpty() ? "Lab " + $F{LabSampleNo} + "  " : "") + CR.nzs($F{OrderRemarks})]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="CellNum" x="153" y="0" width="40" height="20"/><box rightPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{OrderItemQty}]]></textFieldExpression></textField>
                <textField><reportElement style="Cell" x="193" y="0" width="40" height="20"/><box leftPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{UOMCodeItm}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="CellNum" x="233" y="0" width="44" height="20"/><box rightPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{NetWeight}]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="277" y="0" width="44" height="20"/><box rightPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{OrderItemRate} == null ? "" : new java.text.DecimalFormat($V{RatePattern}).format($F{OrderItemRate})]]></textFieldExpression></textField>
                <textField><reportElement style="Cell" x="321" y="0" width="48" height="20"/><box leftPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{UOMCodeRate}]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="369" y="0" width="40" height="20"/><box rightPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{ItemPrice} == null || $F{ItemPrice}.signum() == 0 ? "" : new java.text.DecimalFormat($V{RatePattern}).format($F{ItemPrice})]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="409" y="0" width="44" height="20"/><box rightPadding="2"><rightPen lineWidth="1.0"/></box>
                    <textFieldExpression><![CDATA[$F{RateDiscount} == null || $F{RateDiscount}.signum() == 0 ? "" : new java.text.DecimalFormat($V{RatePattern}).format($F{RateDiscount}) + ("Percent".equals($F{DiscountType}) ? " %" : "")]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="453" y="0" width="91" height="20"/><box rightPadding="3"/>
                    <textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{Amount} == null ? java.math.BigDecimal.ZERO : $F{Amount})]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField><reportElement style="Small" x="0" y="2" width="300" height="11"/>
                <textFieldExpression><![CDATA["Printed " + new java.text.SimpleDateFormat("dd-MMM-yyyy hh:mm a").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField evaluationTime="Master"><reportElement style="Small" x="394" y="2" width="150" height="11"/><textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{MASTER_CURRENT_PAGE} + " of " + $V{MASTER_TOTAL_PAGES}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>
