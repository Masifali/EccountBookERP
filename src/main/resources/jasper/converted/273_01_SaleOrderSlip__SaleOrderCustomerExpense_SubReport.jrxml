<?xml version="1.0" encoding="UTF-8"?>
<!-- SaleOrderCustomerExpense_SubReport.rpt -> JasperReports.
     Data: USP_SaleOrderCustomerExpense_SubReport @OrderId
           Id, SaleOrderId, InvRevExpItemId, Qty, Rate, Amount, Remarks, OtherItemName
     Prints nothing when the order has no customer expense rows (whenNoDataType="NoPages"). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="273_01_SaleOrderSlip__SaleOrderCustomerExpense_SubReport" language="java"
              pageWidth="544" pageHeight="842" columnWidth="544" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="NoPages" uuid="6f1a0f2e-2730-4a45-9d11-273010000002">

    <import value="com.mst.reports.jasper.CR"/>
    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="8" isBlankWhenNull="true"/>
    <style name="Head" style="Base" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E8E8E8"/>
    <style name="Num" style="Base" hTextAlign="Right"/>
    <style name="Bold" style="Base" isBold="true"/>
    <style name="NumBold" style="Num" isBold="true"/>

    <parameter name="CompanyName" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CompanyAddress" class="java.lang.String" isForPrompting="false"/>

    <field name="OtherItemName" class="java.lang.String"/>
    <field name="Qty" class="java.math.BigDecimal"/>
    <field name="Rate" class="java.math.BigDecimal"/>
    <field name="Amount" class="java.math.BigDecimal"/>
    <field name="Remarks" class="java.lang.String"/>

    <variable name="ExpenseTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{Amount}]]></variableExpression>
    </variable>

    <title>
        <band height="14">
            <frame>
                <reportElement style="Head" x="0" y="0" width="544" height="14"/>
                <box><topPen lineWidth="1.0"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Head" x="0" y="0" width="200" height="14"/><box leftPadding="3"/><textElement verticalAlignment="Middle"/><text><![CDATA[Customer Expenses]]></text></staticText>
                <staticText><reportElement style="Head" x="200" y="0" width="60" height="14"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Qty]]></text></staticText>
                <staticText><reportElement style="Head" x="260" y="0" width="70" height="14"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Rate]]></text></staticText>
                <staticText><reportElement style="Head" x="330" y="0" width="90" height="14"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Amount]]></text></staticText>
                <staticText><reportElement style="Head" x="424" y="0" width="120" height="14"/><box leftPadding="4"/><textElement verticalAlignment="Middle"/><text><![CDATA[Remarks]]></text></staticText>
            </frame>
        </band>
    </title>

    <detail>
        <band height="12">
            <frame>
                <reportElement x="0" y="0" width="544" height="12"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement x="0" y="0" width="200" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{OtherItemName}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="200" y="0" width="60" height="12"/><textFieldExpression><![CDATA[$F{Qty}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="260" y="0" width="70" height="12"/><textFieldExpression><![CDATA[$F{Rate}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="330" y="0" width="90" height="12"/><textFieldExpression><![CDATA[$F{Amount}]]></textFieldExpression></textField>
                <textField><reportElement x="424" y="0" width="120" height="12"/><box leftPadding="4"/><textFieldExpression><![CDATA[$F{Remarks}]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <summary>
        <band height="13">
            <frame>
                <reportElement x="0" y="0" width="544" height="13"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Bold" x="0" y="0" width="200" height="13"/><box leftPadding="3"/><text><![CDATA[Total Expenses]]></text></staticText>
                <textField pattern="#,##0.00"><reportElement style="NumBold" x="330" y="0" width="90" height="13"/><textFieldExpression><![CDATA[$V{ExpenseTotal}]]></textFieldExpression></textField>
            </frame>
        </band>
    </summary>
</jasperReport>
