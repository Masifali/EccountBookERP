<?xml version="1.0" encoding="UTF-8"?>
<!-- PurchaseOrder_SupplierDispatchSubReport.rpt -> JasperReports (sub-report of 203A_PurchaseOrderSlip.rpt).
     Data: USP_PurchaseOrder_SupplierDispatchSubReport @PurchaseOrderId
     Prints nothing when the order has no rows (whenNoDataType="NoPages"). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="203A_PurchaseOrderSlip__PurchaseOrder_SupplierDispatchSubReport" language="java"
              pageWidth="544" pageHeight="842" columnWidth="544" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="NoPages">

    <import value="com.mst.reports.jasper.CR"/>
    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="8" isBlankWhenNull="true"/>
    <style name="Head" style="Base" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E6E6E6"/>
    <style name="Num" style="Base" hTextAlign="Right"/>
    <style name="Bold" style="Base" isBold="true"/>
    <style name="NumBold" style="Num" isBold="true"/>

    <parameter name="CompanyName" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CompanyAddress" class="java.lang.String" isForPrompting="false"/>

    <field name="PreBillNo" class="java.lang.String"/>
    <field name="PreBillDate" class="java.util.Date"/>
    <field name="VehicleNo" class="java.lang.String"/>
    <field name="BiltyNo" class="java.lang.String"/>
    <field name="ManualBillNo" class="java.lang.String"/>
    <field name="DeliveryTerm" class="java.lang.String"/>
    <field name="Qty" class="java.math.BigDecimal"/>

    <variable name="SubTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{Qty}]]></variableExpression>
    </variable>

    <title>
        <band height="28">
            <frame>
                <reportElement x="0" y="0" width="544" height="14"/>
                <box><topPen lineWidth="1.0"/><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Bold" x="0" y="0" width="544" height="14"/><box leftPadding="3"/><textElement verticalAlignment="Middle"/><text><![CDATA[Supplier Dispatches (Pre-Bills)]]></text></staticText>
            </frame>
            <frame>
                <reportElement style="Head" x="0" y="14" width="544" height="14"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Head" x="0" y="0" width="60" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Pre-Bill No]]></text></staticText>
                <staticText><reportElement style="Head" x="60" y="0" width="64" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Date]]></text></staticText>
                <staticText><reportElement style="Head" x="124" y="0" width="80" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Vehicle No]]></text></staticText>
                <staticText><reportElement style="Head" x="204" y="0" width="80" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Bilty No]]></text></staticText>
                <staticText><reportElement style="Head" x="284" y="0" width="80" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Manual Bill No]]></text></staticText>
                <staticText><reportElement style="Head" x="364" y="0" width="110" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Delivery Term]]></text></staticText>
                <staticText><reportElement style="Head" x="474" y="0" width="70" height="14"/><box rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Qty]]></text></staticText>
            </frame>
        </band>
    </title>

    <detail>
        <band height="12">
            <frame>
                <reportElement x="0" y="0" width="544" height="12"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement style="Base" x="0" y="0" width="60" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{PreBillNo}]]></textFieldExpression></textField>
                <textField pattern="dd-MMM-yyyy"><reportElement style="Base" x="60" y="0" width="64" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{PreBillDate}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="124" y="0" width="80" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{VehicleNo}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="204" y="0" width="80" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{BiltyNo}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="284" y="0" width="80" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{ManualBillNo}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="364" y="0" width="110" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{DeliveryTerm}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="474" y="0" width="70" height="12"/><box rightPadding="3"/><textFieldExpression><![CDATA[$F{Qty}]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <summary>
        <band height="13">
            <frame>
                <reportElement x="0" y="0" width="544" height="13"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Bold" x="0" y="0" width="200" height="13"/><box leftPadding="3"/><text><![CDATA[Total Dispatched]]></text></staticText>
                <textField pattern="#,##0.00"><reportElement style="NumBold" x="474" y="0" width="70" height="13"/><box rightPadding="3"/><textFieldExpression><![CDATA[$V{SubTotal}]]></textFieldExpression></textField>
            </frame>
        </band>
    </summary>
</jasperReport>
