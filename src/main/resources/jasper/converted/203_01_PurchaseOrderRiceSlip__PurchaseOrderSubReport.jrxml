<?xml version="1.0" encoding="UTF-8"?>
<!-- PurchaseOrderSubReport.rpt -> JasperReports (sub-report of 203_01_PurchaseOrderRiceSlip.rpt).
     Data: USP-PurchaseOrderSubReport @PihId
     Prints nothing when the order has no rows (whenNoDataType="NoPages"). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="203_01_PurchaseOrderRiceSlip__PurchaseOrderSubReport" language="java"
              pageWidth="544" pageHeight="842" columnWidth="544" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="NoPages">

    <import value="com.mst.reports.jasper.CR"/>
    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="8" isBlankWhenNull="true"/>
    <style name="Head" style="Base" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E6E6E6"/>
    <style name="Num" style="Base" hTextAlign="Right"/>
    <style name="Bold" style="Base" isBold="true"/>
    <style name="NumBold" style="Num" isBold="true"/>

    <parameter name="CompanyName" class="java.lang.String" isForPrompting="false"/>
    <parameter name="CompanyAddress" class="java.lang.String" isForPrompting="false"/>

    <field name="ItemName" class="java.lang.String"/>
    <field name="PackTypeDesc" class="java.lang.String"/>
    <field name="EmptyBagsType" class="java.lang.String"/>
    <field name="Rate" class="java.math.BigDecimal"/>
    <field name="WeightCut" class="java.math.BigDecimal"/>


    <title>
        <band height="28">
            <frame>
                <reportElement x="0" y="0" width="544" height="14"/>
                <box><topPen lineWidth="1.0"/><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Bold" x="0" y="0" width="544" height="14"/><box leftPadding="3"/><textElement verticalAlignment="Middle"/><text><![CDATA[Packing Material (Empty Bags)]]></text></staticText>
            </frame>
            <frame>
                <reportElement style="Head" x="0" y="14" width="544" height="14"/>
                <box><topPen lineWidth="0.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Head" x="0" y="0" width="170" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Item]]></text></staticText>
                <staticText><reportElement style="Head" x="170" y="0" width="120" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Packing Type]]></text></staticText>
                <staticText><reportElement style="Head" x="290" y="0" width="134" height="14"/><box leftPadding="3"/><textElement textAlignment="Left" verticalAlignment="Middle"/><text><![CDATA[Bags Type]]></text></staticText>
                <staticText><reportElement style="Head" x="424" y="0" width="60" height="14"/><box rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Rate]]></text></staticText>
                <staticText><reportElement style="Head" x="484" y="0" width="60" height="14"/><box rightPadding="3"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Weight Cut]]></text></staticText>
            </frame>
        </band>
    </title>

    <detail>
        <band height="12">
            <frame>
                <reportElement x="0" y="0" width="544" height="12"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement style="Base" x="0" y="0" width="170" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{ItemName}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="170" y="0" width="120" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{PackTypeDesc}]]></textFieldExpression></textField>
                <textField><reportElement style="Base" x="290" y="0" width="134" height="12"/><box leftPadding="3"/><textFieldExpression><![CDATA[$F{EmptyBagsType}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="424" y="0" width="60" height="12"/><box rightPadding="3"/><textFieldExpression><![CDATA[$F{Rate}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="Num" x="484" y="0" width="60" height="12"/><box rightPadding="3"/><textFieldExpression><![CDATA[$F{WeightCut}]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <summary>
        <band height="2">
            <frame><reportElement x="0" y="0" width="544" height="2"/><box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box></frame>
        </band>
    </summary>
</jasperReport>
