                    <staticText><reportElement style="TotalShade" x="0" y="0" width="150" height="14"/><box leftPadding="3"/><text><![CDATA[Total]]></text></staticText>
                    <textField pattern="#,##0.00"><reportElement style="TotalNum" x="198" y="0" width="40" height="14"/><box rightPadding="2"/><textFieldExpression><![CDATA[$V{QtyTotal}]]></textFieldExpression></textField>
                    <textField pattern="#,##0.00"><reportElement style="TotalNum" x="280" y="0" width="56" height="14"/><box rightPadding="2"/><textFieldExpression><![CDATA[$V{WeightTotal}]]></textFieldExpression></textField>
                    <textField><reportElement style="TotalNum" x="444" y="0" width="100" height="14"/><box rightPadding="2"/><textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($V{AmountTotal} == null ? java.math.BigDecimal.ZERO : $V{AmountTotal})]]></textFieldExpression></textField>
                </frame>
                <!-- desktop: new SubReportObject(..., "PurchaseOrder_SupplierDispatchSubReport.rpt") -->
                <subreport isUsingCache="false">
                    <reportElement x="0" y="18" width="544" height="20" isRemoveLineWhenBlank="true" positionType="Float"/>
                    <parametersMapExpression><![CDATA[CR.subParams($P{REPORT_PARAMETERS_MAP})]]></parametersMapExpression>
                    <subreportParameter name="REPORT_LOCALE"><subreportParameterExpression><![CDATA[$P{REPORT_LOCALE}]]></subreportParameterExpression></subreportParameter>
                    <dataSourceExpression><![CDATA[CR.ds($P{REPORT_PARAMETERS_MAP}, "SUBDATA_PurchaseOrder_SupplierDispatchSubReport")]]></dataSourceExpression>
                    <subreportExpression><![CDATA[CR.sub($P{REPORT_PARAMETERS_MAP}, "SUBREPORT_PurchaseOrder_SupplierDispatchSubReport")]]></subreportExpression>
                </subreport>
                <frame>
                    <reportElement x="0" y="46" width="544" height="44" positionType="Float"/>
                    <box><topPen lineWidth="1.0"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <staticText><reportElement style="Label" x="6" y="4" width="90" height="12"/><text><![CDATA[Amount in Words]]></text></staticText>
                    <textField textAdjust="StretchHeight"><reportElement style="ValueItalic" x="96" y="4" width="440" height="12"/>
                        <textFieldExpression><![CDATA[$V{AmountTotal} == null ? "" : "Rupees " + CR.toWords($V{AmountTotal}, $F{DecimalsForAmount}) + " only"]]></textFieldExpression></textField>
                    <staticText><reportElement style="Label" x="6" y="18" width="90" height="12"/><text><![CDATA[Received / Balance]]></text></staticText>
                    <textField><reportElement style="Value" x="96" y="18" width="300" height="12"/>
                        <textFieldExpression><![CDATA["Received Qty " + new java.text.DecimalFormat("#,##0.00").format($V{ReceivedTotal} == null ? java.math.BigDecimal.ZERO : $V{ReceivedTotal}) + "    Balance Qty " + new java.text.DecimalFormat("#,##0.00").format($V{BalanceTotal} == null ? java.math.BigDecimal.ZERO : $V{BalanceTotal})]]></textFieldExpression></textField>
                    <textField><reportElement style="Small" x="6" y="31" width="530" height="11"/>
                        <textFieldExpression><![CDATA["Entered by " + CR.nzs($F{UserNameEusr}) + ($F{EntryDate} != null ? " on " + new java.text.SimpleDateFormat("dd-MMM-yyyy hh:mm a").format($F{EntryDate}) : "") + ($F{UserNameAusr} != null && !$F{UserNameAusr}.isEmpty() ? "   Approved by " + $F{UserNameAusr} : "")]]></textFieldExpression></textField>
                </frame>
                <frame>
                    <reportElement x="0" y="94" width="544" height="40" positionType="Float"/>
                    <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                    <line><reportElement x="20" y="24" width="130" height="1"/></line>
                    <line><reportElement x="207" y="24" width="130" height="1"/></line>
                    <line><reportElement x="394" y="24" width="130" height="1"/></line>
                    <staticText><reportElement style="Label" x="20" y="26" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Prepared By]]></text></staticText>
                    <staticText><reportElement style="Label" x="207" y="26" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Approved By]]></text></staticText>
                    <staticText><reportElement style="Label" x="394" y="26" width="130" height="11"/><textElement textAlignment="Center"/><text><![CDATA[Supplier]]></text></staticText>
                </frame>
            </band>
        </groupFooter>
    </group>

    <pageHeader>
        <band height="96">
            <frame>
                <reportElement x="0" y="0" width="544" height="62"/>
                <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                    <reportElement x="4" y="4" width="40" height="54"><printWhenExpression><![CDATA[CR.img($F{CompLogoImage}) != null]]></printWhenExpression></reportElement>
                    <imageExpression><![CDATA[CR.img($F{CompLogoImage})]]></imageExpression>
                </image>
                <textField><reportElement style="Company" x="50" y="4" width="488" height="20"/>
                    <textElement verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[$P{CompanyName}]]></textFieldExpression></textField>
                <textField><reportElement style="Value9" x="50" y="26" width="488" height="14"/>
                    <textFieldExpression><![CDATA[$P{CompanyAddress}]]></textFieldExpression></textField>
                <textField><reportElement style="Value" x="50" y="42" width="488" height="12"/>
                    <textFieldExpression><![CDATA[($F{CompMobileA} != null && !$F{CompMobileA}.isEmpty() ? "Ph: " + $F{CompMobileA} : "") + ($F{CompEmailA} != null && !$F{CompEmailA}.isEmpty() ? "     Email: " + $F{CompEmailA} : "") + ($F{CompanyWebsite} != null && !$F{CompanyWebsite}.isEmpty() ? "     " + $F{CompanyWebsite} : "")]]></textFieldExpression></textField>
            </frame>
            <frame>
                <reportElement x="0" y="64" width="544" height="18"/>
                <box><topPen lineWidth="1.5"/><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <staticText><reportElement style="Title" x="0" y="0" width="544" height="18"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"/>
                    <text><![CDATA[PURCHASE ORDER]]></text></staticText>
            </frame>
            <frame>
                <reportElement style="SubTitle" x="0" y="82" width="544" height="14"/>
                <box><leftPen lineWidth="1.5"/><bottomPen lineWidth="1.0"/><rightPen lineWidth="1.5"/></box>
                <textField><reportElement style="SubTitle" x="0" y="0" width="544" height="14"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle"/>
                    <textFieldExpression><![CDATA[($F{DocumentTypeDescription} != null && !$F{DocumentTypeDescription}.isEmpty() ? $F{DocumentTypeDescription} : "Purchase Order Slip - Supplier Dispatch") + ($F{OrderType} != null && !$F{OrderType}.isEmpty() ? "  (" + $F{OrderType} + ")" : "")]]></textFieldExpression></textField>
            </frame>
        </band>
    </pageHeader>

    <detail>
        <band height="20" splitType="Prevent">
            <frame>
                <reportElement x="0" y="0" width="544" height="20"/>
                <box><leftPen lineWidth="1.5"/><rightPen lineWidth="1.5"/></box>
                <textField textAdjust="StretchHeight"><reportElement style="Cell" x="0" y="1" width="150" height="10"/><box leftPadding="3"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[CR.nzs($F{ItemName}) + ($F{ItemCode} != null && !$F{ItemCode}.isEmpty() ? "  [" + $F{ItemCode} + "]" : "")]]></textFieldExpression></textField>
                <textField textAdjust="StretchHeight"><reportElement style="CellSmall" x="0" y="11" width="150" height="9" positionType="Float"/><box leftPadding="3"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[($F{JobLotCode} != null && !$F{JobLotCode}.isEmpty() ? "Lot " + $F{JobLotCode} + "  " : "") + ($F{CityArea} != null && !$F{CityArea}.isEmpty() ? $F{CityArea} + "  " : "") + ($F{LabSampleNo} != null && !$F{LabSampleNo}.isEmpty() ? "Lab " + $F{LabSampleNo} + "  " : "") + ($F{BagWeight} != null && $F{BagWeight}.signum() != 0 ? "Bag Wt " + $F{BagWeight}.stripTrailingZeros().toPlainString() + "  " : "") + CR.nzs($F{OrderRemarks})]]></textFieldExpression></textField>
                <textField><reportElement style="Cell" x="150" y="0" width="48" height="20"/><box leftPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{Crop}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="CellNum" x="198" y="0" width="40" height="20"/><box rightPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{OrderItemQty}]]></textFieldExpression></textField>
                <textField><reportElement style="Cell" x="238" y="0" width="42" height="20"/><box leftPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{UOMCodeItm}]]></textFieldExpression></textField>
                <textField pattern="#,##0.00"><reportElement style="CellNum" x="280" y="0" width="56" height="20"/><box rightPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{NetWeight}]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="336" y="0" width="46" height="20"/><box rightPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{Moisture} == null || $F{Moisture}.signum() == 0 ? "" : new java.text.DecimalFormat("#,##0.##").format($F{Moisture})]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="382" y="0" width="62" height="20"/><box rightPadding="2"><rightPen lineWidth="0.75"/></box><textFieldExpression><![CDATA[$F{OrderItemRate} == null ? "" : new java.text.DecimalFormat($V{RatePattern}).format($F{OrderItemRate}) + ($F{UOMCodeRate} != null && !$F{UOMCodeRate}.isEmpty() ? " /" + $F{UOMCodeRate} : "")]]></textFieldExpression></textField>
                <textField><reportElement style="CellNum" x="444" y="0" width="100" height="20"/><box rightPadding="2"></box><textFieldExpression><![CDATA[new java.text.DecimalFormat($V{AmtPattern}).format($F{Amount} == null ? java.math.BigDecimal.ZERO : $F{Amount})]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <pageFooter>
        <band height="14">
            <textField><reportElement style="Small" x="0" y="2" width="300" height="11"/>
                <textFieldExpression><![CDATA["203A_PurchaseOrderSlip   Printed " + new java.text.SimpleDateFormat("dd-MMM-yyyy hh:mm a").format(new java.util.Date())]]></textFieldExpression></textField>
            <textField evaluationTime="Master"><reportElement style="Small" x="394" y="2" width="150" height="11"/><textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Page " + $V{MASTER_CURRENT_PAGE} + " of " + $V{MASTER_TOTAL_PAGES}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
</jasperReport>
