<?xml version="1.0" encoding="UTF-8"?>
<!--
  203A_PurchaseOrderSlip.rpt  ->  JasperReports (pure Java, no Crystal runtime)
  Layout from the .rpt's own saved preview picture (SummaryInformation thumbnail): boxed company
  header, "PURCHASE ORDER" title bar, grey sub-title bar, 10 + 10 header rows (ruled like a table),
  "Remarks" bar, 8 item columns (Item | Crop | Qty | UOM | Weight | Moisture | Rate | Amount), Total row,
  then the desktop's sub-reports (PurchaseOrder_SupplierDispatchSubReport.rpt), amount in words and signatures.
  Data: Sp_PurchaseOrderSlip_Rpt (@OrganizationId, @CompanyId, @OrderId = the order, @DocumentTypeId = 41),
  exactly the columns PurchaseOrderReports.PurchaseOrderSlipReport203 hands the report.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="203A_PurchaseOrderSlip" language="java" pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="544" leftMargin="26" rightMargin="25" topMargin="28" bottomMargin="28"
              whenNoDataType="NoPages" uuid="6f1a0f2e-2730-4a45-9d11-203A00000001">

    <import value="com.mst.reports.jasper.CR"/>

    <style name="Base" isDefault="true" fontName="SansSerif" fontSize="8" isBlankWhenNull="true"/>
    <style name="Label" style="Base" isBold="true" forecolor="#1F3A5F"/>
    <style name="Value" style="Base" forecolor="#000000"/>
    <style name="ValueBold" style="Value" isBold="true"/>
    <style name="ValueItalic" style="Value" isItalic="true"/>
    <style name="ValueRed" style="Value" forecolor="#C0392B"/>
    <style name="ValueNum" style="Value" hTextAlign="Right"/>
    <style name="Value9" style="Value" fontSize="9"/>
    <style name="Small" style="Base" fontSize="7" forecolor="#555555"/>
    <style name="Company" style="Base" fontSize="15" isBold="true" forecolor="#1F3A5F"/>
    <style name="Title" style="Base" fontSize="12" isBold="true" forecolor="#1F3A5F"/>
    <style name="SubTitle" style="Base" fontSize="9" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E6E6E6"/>
    <style name="Bar" style="Base" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E6E6E6"/>
    <style name="ColHead" style="Base" isBold="true" forecolor="#1F3A5F" mode="Opaque" backcolor="#E6E6E6" hTextAlign="Center" vTextAlign="Middle"/>
    <style name="ColHeadLeft" style="ColHead" hTextAlign="Left"/>
    <style name="Cell" style="Base" vTextAlign="Middle"/>
    <style name="CellNum" style="Cell" hTextAlign="Right"/>
    <style name="CellSmall" style="Base" fontSize="6.5" forecolor="#555555"/>
    <style name="Total" style="Base" isBold="true" vTextAlign="Middle"/>
    <style name="TotalNum" style="Total" hTextAlign="Right"/>
    <style name="TotalShade" style="Total" mode="Opaque" backcolor="#E6E6E6"/>

    <!-- desktop: val.RptPerameter("@CompanyName" / "@CompanyAddress", UserAccount.Comp...) -->
    <parameter name="CompanyName" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
    <parameter name="CompanyAddress" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
    <parameter name="CR_VARS" class="java.lang.Object" isForPrompting="false"/>
    <parameter name="SUBREPORT_PurchaseOrder_SupplierDispatchSubReport" class="net.sf.jasperreports.engine.JasperReport" isForPrompting="false"/>
    <parameter name="SUBDATA_PurchaseOrder_SupplierDispatchSubReport" class="java.util.Collection" isForPrompting="false"/>

    <!-- Sp_PurchaseOrderSlip_Rpt: one row per order line (PoD), header columns repeated -->
