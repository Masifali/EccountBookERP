                    <textField textAdjust="StretchHeight"><reportElement style="Value" x="96" y="4" width="176" height="13"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[CR.nzs($F{DocNo}) + ($F{CatagorySrNo} != null && $F{CatagorySrNo} > 0 ? "   (" + CR.nzs($F{OrderCategoryName}) + " " + $F{CatagorySrNo} + ")" : "")]]></textFieldExpression></textField>
