<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Purchase Order</title>
    <link rel="stylesheet" th:href="@{/build/css/countx_purchase_request.css}">
    <link rel="stylesheet" th:href="@{/vendors/bootstrap/dist/css/bootstrap.min.css}">
    <link rel="stylesheet" th:href="@{/vendors/font-awesome/css/font-awesome.min.css}">
    <link rel="stylesheet" th:href="@{/vendors/select2/dist/css/select2.min.css}">
    <style>
        .select2-container--default .select2-selection--single { height: 24px !important; padding: 1px 4px !important; border: 1px solid #7a9a9e !important; border-radius: 0 !important; font-size: 9pt !important; font-family: "Verdana", sans-serif !important; background-color: #ffffff !important; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 20px !important; padding-left: 2px !important; color: #000000 !important; font-weight: bold; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 22px !important; }
        .select2-dropdown { border: 1px solid #008080 !important; font-size: 9pt !important; border-radius: 0 !important; box-shadow: 0 4px 8px rgba(0,0,0,0.2) !important; z-index: 99999 !important; }
        .select2-search__field { font-size: 9pt !important; padding: 3px !important; border: 1px solid #008080 !important; }
        
        /* 2-Column Select2 Dropdown Styling */
        .select2-2col-header { display: flex; justify-content: space-between; font-weight: bold; background-color: #e0f2f1; padding: 4px 8px; border-bottom: 1px solid #008080; color: #004d40; font-size: 9pt; position: sticky; top: 0; z-index: 10; }
        .select2-2col-row { display: flex; justify-content: space-between; width: 100%; font-size: 9pt; padding: 2px 0; }
        .select2-2col-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
        .select2-2col-code { width: 110px; text-align: right; font-weight: 700; color: #008080; margin-left: 8px; }

        /* 4-Column Select2 Dropdown Styling */
        .select2-4col-header { display: flex; font-weight: bold; background-color: #e0f2f1; padding: 4px 8px; border-bottom: 1px solid #008080; color: #004d40; font-size: 9pt; position: sticky; top: 0; z-index: 10; width: 100%; }
        .select2-4col-row { display: flex; width: 100%; font-size: 9pt; padding: 2px 0; }
        .select2-4col-col1 { flex: 3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
        .select2-4col-col2 { flex: 2; text-align: left; font-weight: 600; color: #008080; margin-left: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .select2-4col-col3 { flex: 2; text-align: left; color: #222222; margin-left: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .select2-4col-col4 { flex: 2; text-align: left; color: #222222; margin-left: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    </style>
    <style>
        body { font-family: "Segoe UI", "Verdana", Tahoma, sans-serif; background-color: #d4d0c8; font-size: 11px; color: #000000; margin: 0; padding: 0; user-select: none; }
        .win-tool-strip { background: linear-gradient(to bottom, #fcfcfc 0%, #e0e0e0 100%); border-bottom: 1px solid #999999; height: 30px; display: flex; align-items: center; padding: 0 4px; gap: 4px; }
        .win-btn-tool { background: transparent; border: 1px solid transparent; padding: 3px 8px; font-size: 11px; color: #000000; cursor: pointer; display: flex; align-items: center; gap: 4px; height: 24px; border-radius: 2px; font-weight: 500; }
        .win-btn-tool:hover { background-color: #ffe4a0; border-color: #e59d00; }
        .win-btn-tool-save { font-weight: bold; color: #004d40; }
        .win-sep { width: 1px; height: 18px; background-color: #b0b0b0; margin: 0 2px; }
        
        .win-teal-header { background-color: #008080; color: #ffffff; height: 28px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px; }
        .win-teal-header-title { font-family: "Tahoma", sans-serif; font-size: 11pt; font-weight: bold; }
        .win-doc-badge { font-weight: bold; font-size: 11pt; color: #ffeb3b; }

        .win-form-body { background-color: #ece9d8; padding: 6px; }
        .win-group-box { border: 1px solid #999999; border-radius: 3px; padding: 6px 8px; margin-bottom: 6px; background-color: #f7f5ed; }
        .win-group-box legend { font-family: "Tahoma", sans-serif; font-size: 9pt; font-weight: bold; color: #004d40; width: auto; padding: 0 4px; margin-bottom: 4px; border: none; }
        
        .win-label { font-size: 8.5pt; font-weight: 600; color: #222222; white-space: nowrap; margin-bottom: 2px; }
        .win-textbox, .win-combo, .win-datepicker { font-family: "Verdana", sans-serif; font-size: 9pt; height: 24px; border: 1px solid #7a9a9e; padding: 2px 4px; box-sizing: border-box; background-color: #ffffff; color: #000000; border-radius: 0; width: 100%; }
        .win-textbox:focus, .win-combo:focus, .win-datepicker:focus { border-color: #008080; outline: 1px solid #008080; }
        .win-textbox-readonly { background-color: #f0f0f0 !important; font-weight: bold; color: #004d40; }
        /* History "Branch Name": the desktop's checked-list UltraCombo (HistoryBranchComboFill) drawn with the
           shared dtcombo shell - closed: one line of ticked names + caret; open: header row with a select-all
           box, the "...Select Any Value..." zero row and one check-box row per branch. */
        .ckcombo-wrap .ckcombo-input { cursor: default; text-overflow: ellipsis; }
        .ckcombo-pop .ckcombo-tick { flex: 0 0 26px; text-align: center; padding: 0; }
        .ckcombo-pop .ckcombo-tick input[type="checkbox"] { cursor: pointer; margin: 0; vertical-align: middle; }
        .ckcombo-pop .ckcombo-name { flex: 1 1 auto; }
        .ckcombo-pop .dtcombo-header .ckcombo-tick input[type="checkbox"] { accent-color: #ffffff; }
        .ckcombo-pop .ckcombo-zero .ckcombo-name { color: #555555; font-style: italic; }
        .ckcombo-pop .ckcombo-row:hover { background-color: #ffe4a0; }
        
        .win-btn-action { background-color: #008080; color: #ffffff; font-family: "Verdana", sans-serif; font-size: 9pt; font-weight: bold; border: 1px solid #004d40; height: 24px; padding: 0 10px; cursor: pointer; border-radius: 2px; }
        .win-btn-action:hover { background-color: #005959; }

        /* Tabs */
        .win-nav-tabs { border-bottom: 1px solid #999999; background-color: #ece9d8; display: flex; gap: 2px; padding-left: 4px; }
        .win-nav-tabs li { list-style: none; }
        .win-nav-tabs li a { display: block; padding: 4px 12px; font-size: 9pt; font-weight: 600; color: #000000; background-color: #d4d0c8; border: 1px solid #999999; border-bottom: none; border-radius: 3px 3px 0 0; text-decoration: none; cursor: pointer; }
        /* tabControl2_DrawItem (PurchsaeOrder.cs :827-838): every tab is painted white, the selected tab's text black,
           every other tab's text red. */
        .win-nav-tabs li a { background-color: #ffffff; color: #cc0000; }
        .win-nav-tabs li a.win-tab-red { color: #cc0000 !important; font-weight: bold; }
        .win-nav-tabs li.active a { background-color: #ffffff !important; border-bottom: 1px solid #ffffff !important; color: #000000 !important; font-weight: bold !important; }
        .win-tab-content { border: 1px solid #999999; border-top: none; background-color: #ffffff; padding: 8px; min-height: 260px; }

        /* Grid Styling */
        .win-grid-container { border: 1px solid #7a9a9e; background-color: #ffffff; }
        .win-grid-scroll { max-height: 220px; overflow-x: auto; overflow-y: auto; }
        .win-grid { width: 100%; border-collapse: collapse; font-family: "Verdana", sans-serif; font-size: 8pt; background-color: #ffffff; }
        .win-grid th { background: linear-gradient(to bottom, #ece9d8 0%, #dbd6c6 100%); color: #000000; font-weight: bold; border: 1px solid #999999; padding: 4px 5px; text-align: left; position: sticky; top: 0; z-index: 5; white-space: nowrap; }
        .win-grid td { border: 1px solid #d0d0d0; padding: 3px 5px; color: #000000; vertical-align: middle; white-space: nowrap; }
        /* In-cell ValueList (combo) editor, ditto a Janus GridEX EditType=4 column: the cell paints
           as plain grid text until it is used, and the list is the only source of values. */
        .win-grid-cell-combo { width: 100%; height: 18px; padding: 0 2px; font-family: "Verdana", sans-serif; font-size: 8pt; color: #000000; background-color: transparent; border: 1px solid transparent; }
        .win-grid-cell-combo:hover { border-color: #7a9a9e; background-color: #ffffff; }
        .win-grid-cell-combo:focus { border-color: #316ac5; background-color: #ffffff; outline: none; }
        .win-grid tr:nth-child(even) { background-color: #fcfcf8; }
        .win-grid tr:hover { background-color: #e0f2f1; cursor: pointer; }

        .win-totals-bar { background: #e0f2f1; font-weight: bold; color: #004d40; font-size: 11px; padding: 6px 12px; border: 1px solid #008080; border-radius: 2px; display: flex; justify-content: space-between; margin-top: 4px; }
        
        /* Modals */
        .modal-winheader { background-color: #008080; color: #ffffff; padding: 6px 12px; font-weight: bold; font-size: 10pt; }
        .win-radio-inline { display: inline-flex; align-items: center; gap: 4px; font-weight: normal; margin-right: 10px; cursor: pointer; }

        @media print {
            .win-tool-strip, .modal, a, button { display: none !important; }
            body { background: #fff !important; margin: 0 !important; padding: 0 !important; }
            .win-form-body { background: #fff !important; padding: 0 !important; }
            .win-grid-scroll { max-height: none !important; overflow: visible !important; }
            .win-grid th, .win-grid td { border: 1px solid #000 !important; color: #000 !important; }
            .win-grid th { background: #eee !important; color: #000 !important; }
        }
    
        /* ---------------------------------------------------------------------------------
           Purchase Order Detail line entry. Absolute, at the designer's own coordinates, so
           the strip reads as the two tight rows the desktop draws rather than a stacked grid.
           --------------------------------------------------------------------------------- */
        .po-lineentry { position: relative; width: 1165px; height: 118px; margin: 4px 0 6px 0; }
        .po-lineentry-scroll { max-width: 100%; overflow-x: auto; overflow-y: hidden; }
        .po-lineentry .lbl { position: absolute; font-size: 8.25pt; line-height: 15px; white-space: nowrap; }
        .po-lineentry .ctl { position: absolute; height: 23px; box-sizing: border-box;
                             font-family: Verdana, Tahoma, sans-serif; font-size: 8.25pt;
                             border: 1px solid #7f9db9; background: #fff; padding: 0 3px; }
        .po-lineentry select.ctl { height: 26px; }
        .po-lineentry .dtcombo-wrap { position: absolute; height: 26px; box-sizing: border-box; }
        .po-lineentry .dtcombo-wrap .dtcombo-input { height: 26px; font-size: 8.25pt; }
        .po-lineentry .ctl.num { text-align: right; }
        .po-lineentry input.win-textbox-readonly { background: #eceae1; }
        .po-lineentry .radios { position: absolute; font-size: 8.25pt; line-height: 19px; white-space: nowrap; }
        .po-lineentry .radios label { margin: 0 10px 0 0; font-weight: normal; }
        .po-lineentry .radios input { vertical-align: -2px; margin-right: 3px; }
        .po-lineentry .po-plus { position: absolute; height: 26px; background: #0A6E6E; color: #fff;
                                 border: 1px solid #075353; font-size: 13pt; line-height: 1;
                                 cursor: pointer; padding: 0; }
        .po-lineentry .po-line-btn { position: absolute; height: 26px; background: #ece9d8;
                                     border: 1px solid #aca899; font-family: Verdana; font-size: 8.25pt;
                                     cursor: pointer; padding: 0; }
        .po-lineentry .po-plus:hover, .po-lineentry .po-line-btn:hover { filter: brightness(1.08); }

        /* ---------------------------------------------------------------------------------
           Header boxes ("Main", "Commission & Brokery") at the running desktop form's own
           pixels: label left of control, 26px rows, white boxes, Segoe UI Semibold 9pt labels,
           Verdana 9.75pt controls. Drawn as divs (not <fieldset>) so absolute children sit at
           the stated x / y.
           --------------------------------------------------------------------------------- */
        .po-head-scroll { max-width: 100%; overflow-x: auto; overflow-y: hidden; margin-bottom: 4px; }
        .po-head { position: relative; width: 1140px; height: 230px; }
        .po-gb { position: absolute; background: #fff; }
        .po-gb > .po-gb-b { position: absolute; left: 0; top: 7px; right: 0; bottom: 0; border: 1px solid #c8c8c8; pointer-events: none; }
        .po-gb > .po-gb-cap { position: absolute; left: 7px; top: -1px; padding: 0 2px; background: #fff; font: bold 9.75pt Tahoma, sans-serif; line-height: 16px; color: #000; white-space: nowrap; }
        .po-gb .hl { position: absolute; font: bold 9pt "Segoe UI Semibold", "Segoe UI", sans-serif; line-height: 15px; color: #000; white-space: nowrap; }
        .po-gb .hs { position: absolute; font: bold 9.75pt "Segoe UI", sans-serif; line-height: 17px; color: #f00; }
        .po-gb .hc { position: absolute; box-sizing: border-box; margin: 0; }
        .po-gb input.hc, .po-gb textarea.hc, .po-gb select.hc { height: 23px; width: auto; font: 9.75pt Verdana, sans-serif; border: 1px solid #7a9a9e; padding: 1px 3px; background: #fff; color: #000; border-radius: 0; }
        .po-gb textarea.hc { padding: 2px 3px; }
        .po-gb div.hc { height: 26px; }
        .po-gb div.hc > select, .po-gb div.hc .dtcombo-wrap { width: 100% !important; }
        .po-gb div.hc > select { height: 26px; font: 9.75pt Verdana, sans-serif; border: 1px solid #7a9a9e; }
        .po-gb div.hc .dtcombo-input { height: 26px; font: 9.75pt Verdana, sans-serif; border-color: #7a9a9e; }
        .po-gb div.hc .select2-container { width: 100% !important; }
        .po-gb div.hc .select2-container--default .select2-selection--single { height: 26px !important; font-size: 9.75pt !important; }
        .po-gb div.hc .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 22px !important; font-weight: normal; }
        .po-gb input.win-textbox-readonly, .po-gb .po-tot { background: #f0f0f0 !important; color: #6d6d6d !important; font-weight: normal !important; }
        .po-gb .po-tot, .po-gb .po-num { text-align: right; }
        .po-gb input.po-date-ro { padding-right: 0; }
        .po-gb select.hc:disabled { background: #f0f0f0; color: #6d6d6d; opacity: 1; }
        .po-gb .hr { position: absolute; margin: 0; font: bold 9pt "Segoe UI Semibold", "Segoe UI", sans-serif; line-height: 19px; white-space: nowrap; cursor: pointer; }
        .po-gb .hr input { vertical-align: -2px; margin: 0 3px 0 0; }
        .po-gb .po-add { width: 22px; height: 22px; padding: 0; border: 1px solid #1b5e20; border-radius: 50%; background: #2e9d3a; color: #fff; font-size: 11px; line-height: 1; cursor: pointer; }
        .po-gb .po-add:hover { background: #1b7a27; }
        .po-gb input[type=number]::-webkit-outer-spin-button, .po-gb input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        .po-gb input[type=number] { -moz-appearance: textfield; }
        .win-form-body { background-color: #fff; }
</style>
