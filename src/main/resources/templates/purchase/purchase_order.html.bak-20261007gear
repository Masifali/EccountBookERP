<body>
<div th:replace="~{fragments/erp_navigation :: navigation}"></div>

    <!-- TOP TOOLBAR -->
    <div class="win-tool-strip">
        <!-- toolStrip1 (PurchsaeOrder.cs designer :10248-10253), in the desktop's order:
             New, Refresh | SaveAs, Save, Update, (Delete - Visible=false, empty handler) |
             203-Print, 203A_Print, 203_01-Print, 203_02-Print | Attachment | Define City,
             (SMS - Visible=false), Load Order | ShortCut Keys -->
        <button type="button" id="btnNew" class="win-btn-tool" onclick="btnNew_Click()"><i class="fa fa-file-o"></i> New</button>
        <button type="button" id="btnRefresh" class="win-btn-tool" onclick="btnRefresh_Click()"><i class="fa fa-refresh"></i> Refresh</button>
        <div class="win-sep"></div>
        <!-- btnSaveAs: shown only after the History "SaveAs" button loads a record (:5091). -->
        <button type="button" id="btnSaveAs" class="win-btn-tool" style="display:none;" onclick="btnSaveAs_Click()"><i class="fa fa-copy"></i> SaveAs</button>
        <button type="button" id="btnSave" class="win-btn-tool win-btn-tool-save" onclick="btnSave_Click()"><i class="fa fa-save"></i> Save</button>
        <button type="button" id="btnUpdate" class="win-btn-tool" style="display:none;" onclick="btnUpdate_Click()"><i class="fa fa-pencil"></i> Update</button>
        <div class="win-sep"></div>
        <button type="button" id="btnPrint203" class="win-btn-tool" onclick="btnPrintReport('203', this)" data-rpt="203-InvRptPurchaseOrderRiceSlip.rpt"><i class="fa fa-print"></i> 203-Print</button>
        <button type="button" id="btnPrint203A" class="win-btn-tool" onclick="btnPrintReport('203A', this)" data-rpt="203A_PurchaseOrderSlip.rpt"><i class="fa fa-print"></i> 203A_Print</button>
        <button type="button" id="btnPrint203_01" class="win-btn-tool" onclick="btnPrintReport('203_01', this)" data-rpt="203_01_PurchaseOrderRiceSlip.rpt"><i class="fa fa-print"></i> 203_01-Print</button>
        <button type="button" id="btnPrint203_02" class="win-btn-tool" onclick="btnPrintReport('203_02', this)" data-rpt="203_02_PurchaseOrderRiceSlip.rpt"><i class="fa fa-print"></i> 203_02-Print</button>
        <div class="win-sep"></div>
        <button type="button" class="win-btn-tool" onclick="openAttachmentsModal()"><i class="fa fa-paperclip"></i> Attachment</button>
        <div class="win-sep"></div>
        <button type="button" class="win-btn-tool" onclick="openDefineCityModal()"><i class="fa fa-map-marker"></i> Define City</button>
        <button type="button" class="win-btn-tool" onclick="openLoadOrderModal()"><i class="fa fa-folder-open-o"></i> Load Order</button>
        <div class="win-sep"></div>
        <button type="button" class="win-btn-tool" onclick="$('#modalShortcuts').modal('show')"><i class="fa fa-keyboard-o"></i> ShortCut Keys</button>
        
        <div style="margin-left: auto;">
            <a href="/purchase" style="color: #004d40; text-decoration: none; font-weight: bold; font-size: 11px;">
                <i class="fa fa-arrow-left"></i> Exit to Dashboard
            </a>
        </div>
    </div>

    <!-- TEAL HEADER -->
    <div class="win-teal-header" style="background-color: #008080; color: #ffffff; height: 28px; display: flex; align-items: center; justify-content: space-between; padding: 0 10px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <div class="win-teal-header-title" style="font-family: 'Tahoma', sans-serif; font-size: 11pt; font-weight: bold; text-transform: uppercase;">PURCHASE ORDER</div>
            <span style="font-size: 8.5pt; font-weight: bold; margin-left: 12px; color: #ffffff;">Location Type</span>
            <select id="cmbLocationType" class="win-combo" style="height: 20px; width: 140px; font-size: 8.5pt; font-weight: normal; color: #000000; background: #ffffff; padding: 0 2px; border: 1px solid #7a9a9e;">
                <option value="0">-- Select --</option>
            </select>
        </div>
        <div style="display: flex; align-items: center; gap: 12px;">
            <label style="margin: 0; font-size: 8.5pt; font-weight: bold; color: #ffffff; cursor: pointer;"><input type="checkbox" id="chkPreview203" checked> Preview 203</label>
            <label style="margin: 0; font-size: 8.5pt; font-weight: bold; color: #ffffff; cursor: pointer;"><input type="checkbox" id="chkPreview203A"> Preview 203A</label>
            <label style="margin: 0; font-size: 8.5pt; font-weight: bold; color: #ffffff; cursor: pointer;"><input type="checkbox" id="chkPreview203_01"> Preview 203_01</label>
            <label style="margin: 0; font-size: 8.5pt; font-weight: bold; color: #ffffff; cursor: pointer;"><input type="checkbox" id="chkPreview203_02"> Preview 203_02</label>
            <div id="lblDocNoDisplay" class="win-doc-badge">PO-1</div>
        </div>
    </div>

    <!-- MAIN FORM BODY -->
    <div class="win-form-body">
        
        <!-- MAIN VIEW: FORM -->
        <div id="mainViewForm">
            <!-- HEADER: groupBox1 "Main" + GroupCommission "Commission & Brokery", laid out as the running
                 desktop form draws them (two fixed-size white boxes side by side, label left of control,
                 one row = 26px). Positions are the desktop's own pixels, measured from each box's
                 top-left corner. Every id, handler and option list is unchanged - only the layout moved. -->
        <div class="po-head-scroll">
        <div class="po-head">
            <!-- ================= Main (604 x 226) ================= -->
            <div class="po-gb" id="groupBox1" style="left:0; top:0; width:604px; height:226px;">
                <div class="po-gb-b"></div><span class="po-gb-cap">Main</span>

                <!-- column 1 -->
                <span class="hl" style="left:5px; top:18px;">Doc &amp; Branch #</span><span class="hs" style="left:96px; top:16px;">*</span>
                <input type="text" id="txtDocNo" class="hc win-textbox win-textbox-readonly" style="left:109px; top:14px; width:100px;" readonly placeholder="PO-1"/>
                <input type="text" id="txtBranchNo" class="hc win-textbox win-textbox-readonly" style="left:212px; top:14px; width:91px;" readonly tabindex="-1"/>

                <span class="hl" style="left:5px; top:44px;">Contract Date</span><span class="hs" style="left:96px; top:42px;">*</span>
                <input type="date" id="txtDocDate" class="hc win-datepicker" style="left:109px; top:40px; width:194px;" onchange="onContractDateChange()"/>

                <span class="hl" style="left:5px; top:71px;">Catagory &amp; No</span><span class="hs" style="left:96px; top:69px;">*</span>
                <!-- OrderCatagoryfill(): BindDDLNew(dt, combordercat, "Id", "OrderCategoryName", "Category", true) -->
                <div class="hc" style="left:109px; top:66px; width:128px;">
                    <select id="cmbParentCategory" class="win-input dtcombo" data-dtcombo="single" data-dtcombo-caption="Category" data-header-col1="Category" onchange="onParentCategoryChange()">
                        <option value="0">...Select Any Value...</option>
                    </select>
                </div>
                <input type="text" id="txtCategoryNo" class="hc win-textbox win-textbox-readonly" style="left:240px; top:67px; width:63px;" readonly tabindex="-1"/>

                <!-- RdPartyByName / RdPartyByCode (:1867-1896). The desktop shows only the "Code" radio beside
                     the caption; Name is the default mode. Clicking Code again goes back to Name. -->
                <span class="hl" style="left:5px; top:99px;">Supplier</span>
                <input type="radio" name="radSupSearch" id="radSupName" checked onclick="onSupplierSearchModeChange()" style="display:none;">
